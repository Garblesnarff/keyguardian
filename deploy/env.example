# Compose project name (keeps volume/container names stable)
COMPOSE_PROJECT_NAME=keyguardian

# App
SECRET_KEY=replace_with_secure_random
SQLALCHEMY_ECHO=false

# Domain/SSL
DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com

# Postgres
POSTGRES_DB=keyguardian
POSTGRES_USER=keyguardian
POSTGRES_PASSWORD=replace_with_strong_password
DATABASE_URL=postgresql+psycopg2://keyguardian:replace_with_strong_password@postgres:5432/keyguardian

# Redis
REDIS_URL=redis://redis:6379/0

# Grafana admin
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Backups (AWS credentials should be set on the host or instance profile)
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=s3-bucket-name


